{
    "manifest_version": 3,
    "name": "Accessibility Assistant",
    "description": "Accessiblity tool that leverages AI to provide suggestions for improving the accessibility of web pages.",
    "version": "1.0.0",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_title": "Accessibility Assistant",
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "js": ["contentScript.js"],
            "matches": ["https://developer.chrome.com/docs/extensions/*"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ]
}